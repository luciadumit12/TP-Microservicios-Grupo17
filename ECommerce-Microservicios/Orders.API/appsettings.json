{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // false en produccion para no exponer stack traces al cliente
  // se sobreescribe con true en appsettings.Development.json para ver errores detallados en desarrollo
  "DetailedErrors": false,
  "ConnectionStrings": {
    // cadena de conexion a la base de datos SQLite
    // Data Source=orders.db indica que la base de datos se guarda en un archivo llamado orders.db
    // ese archivo se crea automaticamente en la carpeta del proyecto cuando arranca la app
    // si el archivo no existe, SQLite lo crea solo
    "DefaultConnection": "Data Source=orders.db"
  }
}